# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Supabase
supabase/.branches
supabase/.temp
supabase/snippets

# Claude Code per-user settings
.claude/settings.local.json

# Netlify CLI local state
.netlify

# Edge Function secrets
supabase/functions/.env

# Generated boggle + scrabble dictionary assets — rebuilt from common.words by
# `gmake g-boggle-trie` / `gmake g-scrabble-trie` (run automatically by
# `gmake deploy-funcs`; needed before `supabase functions serve` locally). Not
# committed; ~1.2 MB each.
supabase/functions/boggle-build-board/wordlist.ts
supabase/functions/scrabble-suggest-move/wordlist.ts

# Hosted-deploy credentials + per-deployment values, sourced by
# supabase/deploy/env.sh. Copy deploy.secrets.example.sh (committed) to
# deploy.secrets.sh (never committed).
deploy.secrets.sh

# The generated resume cache beside it — a new project's DB password and
# its service-role key land here. Named explicitly rather than leaning on
# the *.local rule above, so renaming it can never quietly un-ignore a
# file full of credentials.
.deploy-credentials.cache

# Written by supabase/deploy/fe.sh: the hosted project's URL + publishable
# key, baked into the FE build. Covered by *.local above, but named
# explicitly for the same reason as the credentials cache.
.env.production.local

# gmake db-backup output — pg_dump snapshots of the friends' real data
# (auth accounts included), which must never land in git.
backups/

# Playwright (e2e smoke tests)
/test-results/
/playwright-report/
/playwright/.cache/
# Local before/after board-geometry baseline (machine-specific pixel golden)
/e2e/.artifacts/

# Crosswords puzzle library — Joel keeps his own .puz/.ipuz files here, never committed.
supabase/data/crosswords/
deno.lock

# make stamp files — "what we last loaded, per ENV" (see the Makefile)
.make/

# The screenshot gallery's WORKING output — regenerated wholesale by every
# `gmake gallery` run, so committing it would be a diff of ~30 changed PNGs
# every time. Snapshots worth keeping get copied to gallery-keep/ (committed)
# via `gmake gallery-keep NAME=…`. See docs/gallery-plan.md.
/gallery/
